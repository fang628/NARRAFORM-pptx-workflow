# Normalize source files while preserving Windows launch-script line endings.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Keep intentional workflow-library reference assets as binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.zip binary
